def cb_register():
    s = st.session_state
    errors = []
    required = {"Chassis serial": "r_serial", "Make": "r_make", "Model": "r_model", "Paint color": "r_color"}
    for label, key in required.items():
        if not s.get(key, "").strip():
            errors.append(f"{label} must not be blank.")
    year = None
    try:
        year = int(s.get("r_year", "").strip())
        if year <= 0:
            errors.append("Assembly year must be a positive number.")
    except ValueError:
        errors.append("Assembly year must be a whole number.")
    rate = None
    try:
        rate = float(s.get("r_rate", "").strip())
        if rate <= 0:
            errors.append("Daily rate must be greater than zero.")
    except ValueError:
        errors.append("Daily rate must be a number.")
    serial = s.get("r_serial", "").strip()
    if serial and any(m["chassis_serial"].lower() == serial.lower()
                      for m in DB["mechs"]):
        errors.append(f"Chassis serial '{serial}' is already registered.")
    if errors:
        notify("reg", "error", "\n\n".join(errors))
        return
    mid = DB["next"]["mech"]
    DB["next"]["mech"] += 1
    DB["mechs"].append({
        "mech_id": mid, "chassis_serial": serial,
        "make": s["r_make"].strip(), "model": s["r_model"].strip(),
        "assembly_year": year, "paint_color": s["r_color"].strip(),
        "daily_rate": rate, "combat_hours": 0.0, "status": "Available",
        "type_id": s["r_type"], "garage_id": s["r_garage"]})
    cb_clear_form()
    notify("reg", "success", f"Mech registered with Mech ID {mid}.")


