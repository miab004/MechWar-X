                st.markdown(f"### {c['first_name']} {c['last_name']}")
                st.caption(f"{c['email']} · {c['phone']} · pilot license "
                           f"expires {c['license_expiry']}")
            rows = [x for x in DB["manifests"] if x["client_id"] == cid]
            if scope.startswith("Ongoing"):
                rows = [x for x in rows if x["status"] in OPEN]
            elif scope.startswith("Historical"):
                rows = [x for x in rows
                        if x["status"] in ("Completed", "Cancelled")]
            rows.sort(key=lambda x: x["scheduled_start"], reverse=True)
            if not rows:
                st.warning("This client has no matching manifests.")
            else:
                x1, x2, x3 = st.columns(3)
                x1.metric("Manifests", len(rows))
                x2.metric("Estimated total",
                          f"${sum(x['estimated_cost'] for x in rows):,.2f}")
                x3.metric("Final cost total", "${:,.2f}".format(
                    sum(x["actual_cost"] or 0 for x in rows)))
                table(manifest_frame(rows))

