with tab3:
    st.header("Rental Scheduling")
    st.write("Schedule and manage mech rentals here.")
    c_ids, c_lab = options(DB["clients"], "client_id",
                           lambda r: f"{r['client_id']} - {r['first_name']} {r['last_name']}")
    m_ids, m_lab = options(DB["mechs"], "mech_id",
                           lambda r: f"{r['mech_id']} - {r['chassis_serial']} {r['model']} [{r['status']}]")
    g_ids, g_lab = options(DB["garages"], "garage_id", lambda r: r["name"])

    st.subheader("Mech availability")
    fleet_cards()

    tomorrow = date.today() + timedelta(days=1)
    with st.container(border=True):
        st.subheader("📝 New deployment manifest")
        c1, c2, c3 = st.columns(3)
        c1.selectbox("Client / pilot", c_ids, format_func=c_lab.get,
                     key="b_client")
        c2.selectbox("Mech", m_ids, format_func=m_lab.get, key="b_mech")
        c3.selectbox("Pickup garage", g_ids, format_func=g_lab.get,
                     key="b_garage")
        d1, t1, d2, t2 = st.columns(4)
        d1.date_input("Deployment date", value=tomorrow, key="b_sd")
        t1.time_input("Deployment time", value=time(9, 0), key="b_st")
        d2.date_input("Hangar return date", value=tomorrow + timedelta(days=2),
                      key="b_ed")
        t2.time_input("Hangar return time", value=time(18, 0), key="b_et")

        start, end = booking_window()
        if end <= start:
            st.warning("Return must be after deployment.")
        else:
            hours = (end - start).total_seconds() / 3600
            days = max(1, math.ceil(hours / 24))
            rate = find("mechs", "mech_id", st.session_state["b_mech"])["daily_rate"]
            st.info(f"Window: **{hours:.1f} hours** ({days} billable day(s)) "
                    f"· Estimated cost: **${days * rate:,.2f}**")
        b1, b2 = st.columns(2)
        b1.button("🔎 Check availability", on_click=cb_check,
                  use_container_width=True)
        b2.button("✅ Book mech", type="primary", on_click=cb_book,
                  use_container_width=True)
        show_msg("book")

    st.subheader("Open manifests")
    open_m = sorted([x for x in DB["manifests"] if x["status"] in OPEN],
                    key=lambda x: x["scheduled_start"])
    if not open_m:
        st.info("No open manifests. Book a mech above.")
    else:
        table(manifest_frame(open_m))
        ids, lab = options(open_m, "serial_id",
                           lambda r: f"#{r['serial_id']} · mech {r['mech_id']} · "
                                     f"{fmt(r['scheduled_start'])} → {fmt(r['scheduled_end'])}")
        col_a, col_b = st.columns(2)
        with col_a.container(border=True):
            st.markdown("**❌ Cancel a manifest**")
            st.selectbox("Manifest", ids, format_func=lab.get, key="cx")
            st.checkbox("I confirm this cancellation", key="cx_confirm")
            st.button("Cancel manifest", on_click=cb_cancel,
                      use_container_width=True)
            show_msg("cancel")
        with col_b.container(border=True):
            st.markdown("**✅ Complete a manifest**")
            st.selectbox("Manifest", ids, format_func=lab.get, key="cp")
            st.selectbox("Return garage", g_ids, format_func=g_lab.get,
                         key="rg")
            x1, x2, x3, x4 = st.columns(4)
            x1.date_input("Start date", key="asd")
            x2.time_input("Start time", value=time(9, 0), key="ast")
            x3.date_input("Return date", key="aed")
            x4.time_input("Return time", value=time(17, 0), key="aet")
            st.button("Mark completed", on_click=cb_complete,
                      use_container_width=True)
            show_msg("complete")
    show_msg("cancel")
    show_msg("complete")

