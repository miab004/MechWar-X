def notify(slot, kind, text):
    st.session_state["msg_" + slot] = (kind, text)


def show_msg(slot):
    m = st.session_state.pop("msg_" + slot, None)
    if m:
        getattr(st, m[0])(m[1])


def table(df):
    st.dataframe(df, hide_index=True,
                 column_config={"estimated_cost": MONEY, "actual_cost": MONEY,
                                "daily_rate": MONEY})


def options(rows, id_col, label_fn):
    return [r[id_col] for r in rows], {r[id_col]: label_fn(r) for r in rows}


def manifest_frame(rows):
    out = []
    for x in rows:
        m = find("mechs", "mech_id", x["mech_id"])
        gp = find("garages", "garage_id", x["pickup_garage_id"])
        gr = find("garages", "garage_id", x["return_garage_id"])
        out.append({
            "serial_id": x["serial_id"], "client_id": x["client_id"],
            "chassis_serial": m["chassis_serial"], "model": m["model"],
            "scheduled_start": fmt(x["scheduled_start"]),
            "scheduled_end": fmt(x["scheduled_end"]),
            "actual_start": fmt(x["actual_start"]),
            "actual_end": fmt(x["actual_end"]),
            "estimated_cost": x["estimated_cost"],
            "actual_cost": x["actual_cost"],
            "status": ICON[x["status"]],
            "pickup_garage": gp["name"],
            "return_garage": gr["name"] if gr else ""})
    return pd.DataFrame(out)


def log_frame(rows):
    out = []
    for l in rows:
        m = find("mechs", "mech_id", l["mech_id"])
        s = find("staff", "staff_id", l["chief_staff_id"])
        out.append({
            "log_id": l["log_id"], "mech_id": l["mech_id"],
            "chassis_serial": m["chassis_serial"],
            "issue_type": ICON[l["issue_type"]], "status": ICON[l["status"]],
            "reported": fmt(l["report_ts"]), "description": l["description"],
            "chief": s["full_name"] if s else "",
            "resolved": fmt(l["resolution_ts"]),
            "engineering_notes": l["engineering_notes"]})
    return pd.DataFrame(out)


