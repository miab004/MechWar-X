# BUSINESS RULES ("stored procedures")
# =====================================================================
def refresh_status(mech_id):
    """Recompute a mech's status: open Critical log > live booking > free."""
    m = find("mechs", "mech_id", mech_id)
    if any(l["mech_id"] == mech_id and l["issue_type"] == "Critical"
           and l["status"] != "Repaired" for l in DB["logs"]):
        m["status"] = "Unavailable"
    elif any(x["mech_id"] == mech_id and x["status"] in OPEN
             for x in DB["manifests"]):
        m["status"] = "Reserved"
    else:
        m["status"] = "Available"


def find_conflicts(mech_id, start, end):
    return [x for x in DB["manifests"]
            if x["mech_id"] == mech_id and x["status"] in OPEN
            and start < x["scheduled_end"] and end > x["scheduled_start"]]


def proc_a_book(client_id, mech_id, garage_id, start, end):
    """PROCEDURE A: double-booking overlap prevention. Raises ValueError."""
    if end <= start:
        raise ValueError("Return date/time must be after the deployment time.")
    if start < datetime.now():
        raise ValueError("Deployment window cannot start in the past.")
    mech = find("mechs", "mech_id", mech_id)
    client = find("clients", "client_id", client_id)
    if mech is None or client is None:
        raise ValueError("Mech or client does not exist.")
    if mech["status"] == "Unavailable":
        raise ValueError("Mech is Unavailable (critical failure under repair).")
    if client["license_expiry"] < end.date():
        raise ValueError("Pilot combat license expires before the end of the window.")
    clash = find_conflicts(mech_id, start, end)
    if clash:
        raise ValueError("Conflict: mech is already reserved during that window "
                         f"(manifest #{clash[0]['serial_id']}).")
    hours = (end - start).total_seconds() / 3600
    cost = max(1, math.ceil(hours / 24)) * mech["daily_rate"]
    sid = DB["next"]["manifest"]
    DB["next"]["manifest"] += 1
    DB["manifests"].append({
        "serial_id": sid, "client_id": client_id, "mech_id": mech_id,
        "pickup_garage_id": garage_id, "return_garage_id": None,
        "scheduled_start": start, "scheduled_end": end,
        "actual_start": None, "actual_end": None,
        "estimated_cost": cost, "actual_cost": None, "status": "Match Booked"})
    refresh_status(mech_id)
    return sid, cost


def proc_b_cancel(serial_id):
    """PROCEDURE B: cancelling a manifest automatically re-syncs the mech."""
    x = find("manifests", "serial_id", serial_id)
    if x is None or x["status"] not in OPEN:
        raise ValueError("Manifest not found or already Completed/Cancelled.")
    x["status"] = "Cancelled"
    refresh_status(x["mech_id"])


def proc_c_report(mech_id, client_id, issue_type, desc, chief_id):
    """PROCEDURE C: a Critical log locks the mech as Unavailable."""
    if not desc.strip():
        raise ValueError("Damage description must not be blank.")
    lid = DB["next"]["log"]
    DB["next"]["log"] += 1
    DB["logs"].append({
        "log_id": lid, "mech_id": mech_id, "client_id": client_id,
        "report_ts": datetime.now(), "issue_type": issue_type,
        "description": desc.strip(), "status": "Reported",
        "resolution_ts": None, "chief_staff_id": chief_id,
        "engineering_notes": ""})
    if issue_type == "Critical":
        find("mechs", "mech_id", mech_id)["status"] = "Unavailable"
    return lid


