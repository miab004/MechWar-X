            g = find("garages", "garage_id", s["garage_id"])
            crew.append({"garage": g["name"], "dispatch_phone": g["dispatch_phone"],
                         "name": s["full_name"], "role": s["role"],
                         "phone": s["phone"], "email": s["email"]})
        st.dataframe(pd.DataFrame(crew), hide_index=True)

    with st.expander("📜 Resolved incident history"):
        done = [l for l in DB["logs"] if l["status"] == "Repaired"]
        if not done:
            st.caption("Nothing resolved yet.")
        else:
            table(log_frame(done))
