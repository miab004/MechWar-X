    else:
        st.session_state["s_active"] = int(txt)


def booking_window():
    s = st.session_state
    return (datetime.combine(s["b_sd"], s["b_st"]),
            datetime.combine(s["b_ed"], s["b_et"]))


def cb_check():
    s = st.session_state
    start, end = booking_window()
    if end <= start:
        notify("book", "error", "Return must be after deployment.")
        return
    mech = find("mechs", "mech_id", s["b_mech"])
    clash = find_conflicts(s["b_mech"], start, end)
    if mech["status"] == "Unavailable":
        notify("book", "error", "🔴 Mech is Unavailable (critical failure).")
    elif clash:
        notify("book", "error", "🔴 Conflict with manifest(s): "
               + ", ".join(f"#{x['serial_id']}" for x in clash))
    else:
        notify("book", "success", "🟢 Mech is free for this window.")


def cb_book():
    s = st.session_state
    start, end = booking_window()
    try:
        sid, cost = proc_a_book(s["b_client"], s["b_mech"], s["b_garage"],
                                start, end)
        notify("book", "success",
               f"Manifest #{sid} booked. Estimated cost: ${cost:,.2f}")
    except ValueError as e:
        notify("book", "error", f"🚫 Booking rejected: {e}")


def cb_cancel():
    s = st.session_state
    if not s.get("cx_confirm"):
        notify("cancel", "warning", "Tick the confirmation box first.")
        return
    try:
        proc_b_cancel(s["cx"])
        s["cx_confirm"] = False
        notify("cancel", "success", f"Manifest #{s['cx']} cancelled. The mech "
               "status was re-synchronised automatically.")
    except ValueError as e:
        notify("cancel", "error", str(e))


def cb_complete():
    s = st.session_state
    start = datetime.combine(s["asd"], s["ast"])
    end = datetime.combine(s["aed"], s["aet"])
    if end <= start:
        notify("complete", "error", "Actual return must be after actual start.")
        return
    x = find("manifests", "serial_id", s["cp"])
    if x is None or x["status"] not in OPEN:
        notify("complete", "error", "Manifest not found or not open.")
        return
    m = find("mechs", "mech_id", x["mech_id"])
    hrs = (end - start).total_seconds() / 3600
    x.update(actual_start=start, actual_end=end, status="Completed",
             return_garage_id=s["rg"],
             actual_cost=max(1, math.ceil(hrs / 24)) * m["daily_rate"])
    m["combat_hours"] += hrs
    refresh_status(m["mech_id"])
    notify("complete", "success", f"Manifest #{x['serial_id']} completed. "
           f"Combat hours added: {hrs:.2f}. Final cost: ${x['actual_cost']:,.2f}")


def cb_report():
    s = st.session_state
    try:
        proc_c_report(s["i_mech"], s["i_client"], s["i_type"], s["i_desc"],
                      s["i_chief"])
        s["i_desc"] = ""
        if s["i_type"] == "Critical":
            notify("inc", "success", "Critical failure logged. The mech was "
                   "locked as Unavailable automatically.")
        else:
            notify("inc", "success", "Routine servicing request logged.")
    except ValueError as e:
        notify("inc", "error", str(e))


def cb_progress():
    s = st.session_state
    log = find("logs", "log_id", s["pid"])
    if log is None:
        return
    log["status"] = s["pstat"]
    notify("res", "success", f"Log #{log['log_id']} set to {s['pstat']}.")


def cb_resolve():
    s = st.session_state
    log = find("logs", "log_id", s["pid"])
    if log is None or log["status"] == "Repaired":
        notify("res", "error", "Log not found or already Repaired.")
        return
    log["status"] = "Repaired"
    log["resolution_ts"] = datetime.now()
    log["engineering_notes"] = s.get("r_notes", "").strip()
    refresh_status(log["mech_id"])
    notify("res", "success", f"Log #{log['log_id']} resolved. The mech status "
           "was re-evaluated.")


